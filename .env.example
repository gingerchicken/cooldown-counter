# Public local-only configuration. Production uses separately provisioned secrets.
COMPOSE_PROJECT_NAME=django-template
LOCAL_WEB_PORT=8788
LOCAL_DEV_PORT=5173
# Keep development ports private unless LAN access is explicitly needed.
LOCAL_BIND_IP=127.0.0.1
# Use native events instead only when the host reliably forwards container file changes.
DEV_WATCH_POLLING=true
