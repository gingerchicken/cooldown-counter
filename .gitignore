# Tool caches, virtual environments, and generated runtime files stay local.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.coverage*
**/coverage.xml
**/htmlcov/
**/node_modules/
**/dist/
**/.wrangler/
**/.vite/
**/coverage/
**/playwright-report/
**/test-results/
**/*.tsbuildinfo
**/*.sqlite3
**/staticfiles/
test-artifacts/

# Real deployment credentials must never become template defaults.
.env
.env.*
!.env.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
*.log
.DS_Store
