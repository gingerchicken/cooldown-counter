{
  "name": "django-react-template-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/api-client"
  ],
  "scripts": {
    "api:generate": "node tooling/watch-api.mjs --once --types-only",
    "api:build": "npm run build --workspace @template/api-client",
    "api:watch": "node tooling/watch-api.mjs",
    "predev": "npm run api:generate && npm run api:build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run api:generate && npm run api:build",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/api-client/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit --reporter=default --reporter=json --outputFile=test-results/unit.json",
    "test:browser": "vitest run --project browser --coverage --coverage.reportsDirectory=coverage/browser --reporter=default --reporter=json --outputFile=test-results/browser.json",
    "test:tooling": "node --test tooling/*.test.mjs",
    "test:e2e": "playwright test",
    "pages:dev": "wrangler pages dev dist --ip 0.0.0.0 --port 8788",
    "pages:build": "wrangler pages functions build functions --outdir .wrangler/pages-functions",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@template/api-client": "*",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
